+/// Copy members of the archive at `archive` into `extract_dir`, reading it once.
+///
+/// `select` gets every member name in archive order (the same list `ar t`
+/// prints) and returns the positions to extract, or `None` to decline. Member
+/// `i` is written to `<prefix>_<i>.obj`, so repeated names never collide.
+/// Returns the written paths in the order `select` gave, or `None` when the
+/// archive cannot be read this way (thin or unrecognized archives, a name list
+/// that does not match the caller's) and the caller should use `llvm-ar x`.
+///
+/// Running `llvm-ar x ARCHIVE MEMBER` once per kept member re-reads the whole
+/// archive each time: ~2,400 runs over the ~150 MB `libperry_ui_gtk4.a`, about
+/// 35 s of every Linux UI link, against well under a second here.
+fn extract_members_in_process(
+    archive: &Path,
+    extract_dir: &Path,
+    prefix: &str,
+    select: impl FnOnce(&[String]) -> Option<Vec<usize>>,
+) -> Option<Vec<PathBuf>> {
+    if std::env::var_os("PERRY_STRIP_DEDUP_AR_EXTRACT").is_some() {
+        return None;
+    }
+    let data = std::fs::read(archive).ok()?;
+    let parsed = object::read::archive::ArchiveFile::parse(&*data).ok()?;
+    if parsed.is_thin() {
+        return None;
+    }
+    let mut names = Vec::new();
+    let mut ranges = Vec::new();
+    for member in parsed.members() {
+        let member = member.ok()?;
+        names.push(String::from_utf8(member.name().to_vec()).ok()?);
+        let (offset, size) = member.file_range();
+        let start = usize::try_from(offset).ok()?;
+        let end = start.checked_add(usize::try_from(size).ok()?)?;
+        if end > data.len() {
+            return None;
+        }
+        ranges.push(start..end);
+    }
+    let wanted = select(&names)?;
+    let mut written = Vec::with_capacity(wanted.len());
+    for i in wanted {
+        let path = extract_dir.join(format!("{prefix}_{i}.obj"));
+        std::fs::write(&path, &data[ranges.get(i)?.clone()]).ok()?;
+        written.push(path);
+    }
+    Some(written)
+}
