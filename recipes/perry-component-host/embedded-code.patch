+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn plain_bytes_resolve_to_themselves() {
+        let bytes = b"\0asm\x0d\0\x01\0";
+        assert_eq!(resolve(bytes).unwrap(), bytes);
+    }
+
+    #[test]
+    fn unknown_embedded_name_is_an_error() {
+        let mut bytes = EMBEDDED_PREFIX.to_vec();
+        bytes.extend_from_slice(b"nope");
+        let err = resolve(&bytes).unwrap_err().to_string();
