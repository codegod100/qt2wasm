-/// `Component::from_binary`, served from the cache when an entry exists.
+/// One ahead-of-time compiled component linked into the binary: `key` is the
+/// 64 hex digits of [`key`] for the bytes it was compiled from, `code` what
+/// `Component::serialize` wrote for them (a `.cwasm`). `name` (a C string)
+/// and `wasm` are optional: the component's own bytes, which a program loads
+/// by passing [`EMBEDDED_PREFIX`] + name instead of the bytes.
+#[repr(C)]
+pub struct EmbeddedComponent {
+    pub key: *const u8,
+    pub code: *const u8,
+    pub len: usize,
+    pub name: *const std::ffi::c_char,
+    pub wasm: *const u8,
+    pub wasm_len: usize,
+}
+
+/// Bytes that start with this name a component linked into the program.
+pub const EMBEDDED_PREFIX: &[u8] = b"\0perry-embedded\0";
+
+// A table of compiled components that the program may link in (null-key
+// terminated), e.g. from a Perry native library made by `perry-gui`'s AOT
+// build. Weak: a program without one links fine and the symbol is null.
+unsafe extern "C" {
+    #[linkage = "extern_weak"]
+    static perry_component_embedded: *const EmbeddedComponent;
+}
+
+fn table() -> *const EmbeddedComponent {
+    // SAFETY: reading the address of a weak symbol (null when absent).
+    unsafe { perry_component_embedded }
+}
+
+/// The bytes to load: `bytes` itself, or the linked-in component it names.
+pub(crate) fn resolve(bytes: &[u8]) -> Result<&[u8]> {
+    let Some(name) = bytes.strip_prefix(EMBEDDED_PREFIX) else {
+        return Ok(bytes);
+    };
+    let mut entry = table();
+    // SAFETY: the table, when present, is a static C array ending in a null key.
+    unsafe {
+        while !entry.is_null() && !(*entry).key.is_null() {
+            let e = &*entry;
+            if !e.name.is_null() && !e.wasm.is_null() && std::ffi::CStr::from_ptr(e.name).to_bytes() == name {
+                return Ok(std::slice::from_raw_parts(e.wasm, e.wasm_len));
+            }
+            entry = entry.add(1);
+        }
+    }
+    anyhow::bail!(
+        "no component named {:?} is linked into this program",
+        String::from_utf8_lossy(name)
+    )
+}
+
+fn embedded(key: &str) -> Option<&'static [u8]> {
+    // SAFETY: the table, when present, is a static C array ending in a null key.
+    unsafe {
+        let mut entry = table();
+        if entry.is_null() {
+            return None;
+        }
+        while !(*entry).key.is_null() {
+            let k = std::slice::from_raw_parts((*entry).key, 64);
+            if k == key.as_bytes() {
+                return Some(std::slice::from_raw_parts((*entry).code, (*entry).len));
+            }
+            entry = entry.add(1);
+        }
+    }
+    None
+}
+
+fn debug() -> bool {
+    std::env::var_os("PERRY_COMPONENT_DEBUG").is_some_and(|v| !v.is_empty() && v != "0")
+}
+
+/// `Component::from_binary`, served from code linked into the program (see
+/// [`EmbeddedComponent`]) or from the on-disk cache when an entry exists.
+/// `PERRY_COMPONENT_KEY_FILE=PATH` writes the key of the component compiled
+/// here to PATH (how an AOT build finds its cache entry).
 pub(crate) fn compile(engine: &Engine, bytes: &[u8]) -> Result<Component> {
+    let t0 = std::time::Instant::now();
+    let k = key(engine, bytes);
+    if let Some(path) = std::env::var_os("PERRY_COMPONENT_KEY_FILE").filter(|v| !v.is_empty()) {
+        let _ = std::fs::write(path, &k);
+    }
+    if let Some(code) = embedded(&k) {
+        // SAFETY: the code was serialized by this host's engine configuration
+        // for exactly these bytes (the key covers the wasmtime build, Config
+        // and the bytes) and linked into this program at build time; wasmtime
+        // checks the header's version and flags again.
+        match unsafe { Component::deserialize(engine, code) } {
+            Ok(component) => {
+                if debug() {
+                    eprintln!("perry-component-host: embedded code {} ({} bytes) in {:?}", &k[..16], code.len(), t0.elapsed());
+                }
+                return Ok(component);
+            }
+            Err(e) => {
