diff --git a/crates/perry-component-host/src/code_cache.rs b/crates/perry-component-host/src/code_cache.rs
new file mode 100644
index 00000000..e85fab6d
--- /dev/null
+++ b/crates/perry-component-host/src/code_cache.rs
@@ -0,0 +1,93 @@
+//! On-disk cache of compiled components, keyed on the SHA-256 of the
+//! component bytes and the engine's precompile compatibility hash, so a
+//! changed component, Config or wasmtime build never reuses stale code.
+//!
+//! Location: `$PERRY_COMPONENT_CACHE_DIR`, else
+//! `$XDG_CACHE_HOME/perry-component-host`, else `~/.cache/perry-component-host`.
+//! `PERRY_COMPONENT_CACHE=0` disables it. Any cache failure falls back to a
+//! plain compile; a corrupt or incompatible entry is recompiled and replaced.
+use anyhow::Result;
+use sha2::{Digest, Sha256};
+use std::hash::{Hash, Hasher};
+use std::path::PathBuf;
+use wasmtime::component::Component;
+use wasmtime::Engine;
+
+struct ShaHasher(Sha256);
+impl Hasher for ShaHasher {
+    fn finish(&self) -> u64 {
+        0
+    }
+    fn write(&mut self, bytes: &[u8]) {
+        self.0.update(bytes);
+    }
+}
+
+fn dir() -> Option<PathBuf> {
+    if std::env::var_os("PERRY_COMPONENT_CACHE").is_some_and(|v| v == "0") {
+        return None;
+    }
+    if let Some(dir) = std::env::var_os("PERRY_COMPONENT_CACHE_DIR").filter(|v| !v.is_empty()) {
+        return Some(PathBuf::from(dir));
+    }
+    let base = std::env::var_os("XDG_CACHE_HOME")
+        .filter(|v| !v.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("HOME")
+                .filter(|v| !v.is_empty())
+                .map(|h| PathBuf::from(h).join(".cache"))
+        })?;
+    Some(base.join("perry-component-host"))
+}
+
+fn key(engine: &Engine, bytes: &[u8]) -> String {
+    let mut hasher = ShaHasher(Sha256::new());
+    hasher.write(env!("CARGO_PKG_VERSION").as_bytes());
+    engine.precompile_compatibility_hash().hash(&mut hasher);
+    hasher.write(&(bytes.len() as u64).to_le_bytes());
+    hasher.write(bytes);
+    hasher
+        .0
+        .finalize()
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect()
+}
+
+/// `Component::from_binary`, served from the cache when an entry exists.
+pub(crate) fn compile(engine: &Engine, bytes: &[u8]) -> Result<Component> {
+    let Some(dir) = dir() else {
+        return Ok(Component::from_binary(engine, bytes)?);
+    };
+    let path = dir.join(format!("{}.cwasm", key(engine, bytes)));
+    if path.is_file() {
+        // SAFETY: entries are written only by `serialize` below from this
+        // engine configuration (the key covers it) into the user's own cache
+        // directory; wasmtime also checks the header's version and flags.
+        match unsafe { Component::deserialize_file(engine, &path) } {
+            Ok(component) => return Ok(component),
+            Err(_) => {
+                let _ = std::fs::remove_file(&path);
+            }
+        }
+    }
+    let component = Component::from_binary(engine, bytes)?;
+    if let Ok(code) = component.serialize() {
+        let _ = store(&dir, &path, &code);
+    }
+    Ok(component)
+}
+
+fn store(dir: &std::path::Path, path: &std::path::Path, code: &[u8]) -> std::io::Result<()> {
+    std::fs::create_dir_all(dir)?;
+    let tmp = dir.join(format!(
+        ".{}.{}.tmp",
+        path.file_name().unwrap().to_string_lossy(),
+        std::process::id()
+    ));
+    std::fs::write(&tmp, code)?;
+    std::fs::rename(&tmp, path).inspect_err(|_| {
+        let _ = std::fs::remove_file(&tmp);
+    })
+}
