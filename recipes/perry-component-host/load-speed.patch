+#[test]
+fn zero_fuel_runs_unmetered_until_interrupted() {
+    let mut host = host(Options {
+        fuel: 0,
+        ..Options::default()
+    });
+    assert_eq!(
+        host.call("perry:test/transform@1.0.0", "returned", &[])
+            .unwrap(),
+        Some(json!(0))
+    );
+    let interrupt = host.interrupt_handle();
+    let thread = std::thread::spawn(move || {
+        // Far past what the default 10M fuel budget allows.
+        std::thread::sleep(std::time::Duration::from_millis(200));
+        interrupt.interrupt();
+    });
+    let error = host
+        .call("perry:test/transform@1.0.0", "spin", &[])
+        .unwrap_err();
+    thread.join().unwrap();
+    assert!(format!("{error:#}").contains("interrupt"), "{error:#}");
+}
