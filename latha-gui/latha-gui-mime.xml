<?xml version="1.0" encoding="UTF-8"?>
<!-- application/wasm, for systems whose shared-mime-info predates it. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/wasm">
    <comment>WebAssembly module</comment>
    <magic priority="50">
      <match type="string" value="\0asm" offset="0"/>
    </magic>
    <glob pattern="*.wasm"/>
  </mime-type>
</mime-info>
