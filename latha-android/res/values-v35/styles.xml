<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ draws apps targeting SDK 35 edge to edge, under the status
         and navigation bars. We paint one rectangle and take no insets, so opt
         out and let the system keep the bars clear of the frame. -->
    <style name="LathaTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
